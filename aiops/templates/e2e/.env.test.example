# E2E 로컬 실행용 환경변수 템플릿 (이슈 #117)
# 사용법:
#   cp templates/e2e/.env.test.example .env.test
# 그 후 값만 채워 사용한다. .gitignore에 .env.test가 등록되어 있어 커밋되지 않는다.

# --- 환경/모드 (인자 미지정 시 폴백 값) ---
# 명시적 인자 > 환경변수 > 기본값(dev/full) 우선순위
E2E_ENV=local
E2E_MODE=full

# --- baseURL ---
# local: localhost 또는 wrangler dev 포트
E2E_LOCAL_URL=http://localhost:8787
# dev / prod URL은 .env.test에 둘 필요는 없으나, 동일 셸에서 --env=dev 검증 시 사용 가능
# E2E_DEV_URL=https://dev.example.workers.dev
# E2E_PROD_URL=https://app.example.com

# --- 고정 테스트 계정 (local에서는 mock 값 사용 가능) ---
E2E_TEST_USER=e2e@local.test
E2E_TEST_PASS=local-test-password

# --- 헬스체크 경로 (선택, 기본값 /health) ---
# E2E_HEALTHCHECK_PATH=/health

# --- prod smoke 안전장치 (#117 M4) ---
# --env=prod 실행 시 반드시 설정되어야 함. local에서는 미사용.
# 운영 배포 스킬(#121)이 자동 주입하므로 로컬에서 수동 설정할 일은 거의 없음.
# BLAST_RADIUS_GUARD=1

# --- CI 환경 표시 ---
# CI 환경(예: GitHub Actions)에서만 1 설정 → Playwright forbidOnly + 재시도 동작.
# 로컬에서는 미설정 권장.
# CI=1
