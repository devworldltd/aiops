# CLI E2E 로컬 실행용 환경변수 템플릿 (이슈 #41)
# 사용법:
#   cp .env.test.example .env.test
# 그 후 값만 채워 사용한다. .gitignore에 .env.test가 등록되어 있어 커밋되지 않는다.
#
# CLI 는 배포 대상이 없는 local 단일 환경이다(기술 스펙 결정 (d)) —
# E2E_LOCAL_URL/E2E_DEV_URL/E2E_PROD_URL 계열 키는 사용하지 않는다.

# --- 모드 (인자 미지정 시 폴백 값) ---
E2E_MODE=full

# --- CLI 진입점 ---
# 비워두면 package.json 의 bin 첫 엔트리로 자동 해석한다.
E2E_CLI_BIN=./dist/cli.js

# --- 시나리오 디렉토리 재해석 (선택) ---
# 비워두면 mode 기본값(full/ 또는 smoke/)을 사용한다. 콤마/공백 구분 다중 경로 지원.
# E2E_FULL_PATHS=full
# E2E_SMOKE_PATHS=smoke

# --- 임시 작업 디렉토리 (선택) ---
# 비워두면 OS 임시 디렉토리(os.tmpdir())를 사용한다. CLI 시나리오는 이 아래에서만 쓴다.
# E2E_TEST_WORKDIR=

# --- PTY 옵트인 (선택, 이슈 #41 결정 (b)) ---
# node-pty 설치 시에만 대화형(PTY) 시나리오를 활성화한다. 미설치/미설정 시 해당 시나리오는 SKIPPED.
# E2E_PTY=1
