# iOS Fastlane — TestFlight Internal/External + App Store Production
# 사전 조건:
# - bundle install
# - Match (Git 인증서 저장소) 설정
# - App Store Connect API Key (.p8)
# - 환경변수: APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_ISSUER_ID, MATCH_PASSWORD

default_platform(:ios)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "fastlane/asc-key.p8",
      duration: 1200,
      in_house: false
    )
  end

  desc "Build and sign"
  private_lane :build do
    match(type: "appstore", readonly: true)
    increment_build_number(xcodeproj: "App.xcodeproj")
    build_app(
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      output_name: "App.ipa"
    )
  end

  desc "TestFlight Internal"
  lane :internal do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "TestFlight External (Beta groups)"
  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: ["Beta Testers"]
    )
  end

  desc "App Store Production"
  lane :production do
    build
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true
    )
  end
end
